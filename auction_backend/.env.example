# Django core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=UTC
DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_ROOT=media

# Database
DATABASE_URL=sqlite:///db.sqlite3
# SQLITE_DB_PATH can be used instead of DATABASE_URL for sqlite.
# SQLITE_DB_PATH=/var/data/db.sqlite3

# CORS/CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# App-specific security
AUCTION_RESET_PIN=2254
SERVE_MEDIA_FILES=True

# HTTPS/security (used when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
